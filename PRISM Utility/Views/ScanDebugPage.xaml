                                     PointerPressed="PreviewScrollViewer_PointerPressed"
                                     PointerMoved="PreviewScrollViewer_PointerMoved"
                                     PointerReleased="PreviewScrollViewer_PointerReleased"
                                     PointerCanceled="PreviewScrollViewer_PointerCanceled"
                                     PointerCaptureLost="PreviewScrollViewer_PointerCaptureLost"
                                     PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged">
                                <Canvas x:Name="PreviewCanvas">
                                     <canvas:CanvasControl
                                         x:Name="PreviewCanvasControl"
                                         AutomationProperties.AutomationId="PreviewCanvasControl"
                                         AutomationProperties.AccessibilityView="Control"
                                         ClearColor="Transparent"
                                        CreateResources="PreviewCanvasControl_CreateResources"
                                        Draw="PreviewCanvasControl_Draw"
                                        PointerPressed="PreviewCanvasControl_PointerPressed"
                                         PointerMoved="PreviewCanvasControl_PointerMoved"
                                         PointerReleased="PreviewCanvasControl_PointerReleased"
                                         PointerCanceled="PreviewCanvasControl_PointerCanceled"
                                         PointerCaptureLost="PreviewCanvasControl_PointerCaptureLost"
                                         PointerExited="PreviewCanvasControl_PointerExited"/>
                                    <Canvas x:Name="RoiCanvas"
                                            IsHitTestVisible="False"/>
                                    <Canvas x:Name="AxisCanvas"
                                            IsHitTestVisible="False"/>
                                </Canvas>
                            </ScrollViewer>
                            <Grid
                                x:Name="PreviewEmptyStateGrid"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="{StaticResource ScanDebugInlineSpacing}">
                                    <TextBlock x:Uid="ScanDebug_PreviewEmptyTitle"
                                               HorizontalAlignment="Center"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Uid="ScanDebug_PreviewEmptyDescription"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                </StackPanel>
                            </Grid>
                             <ScrollViewer x:Name="RawSignalProfileScrollViewer"
                                           AutomationProperties.AutomationId="RawSignalProfileScrollViewer"
                                           Visibility="Collapsed"
                                           SizeChanged="RawSignalProfileScrollViewer_SizeChanged"
                                           VerticalScrollBarVisibility="Disabled"
                                           VerticalScrollMode="Disabled"
                                           HorizontalScrollBarVisibility="Disabled"
                                           HorizontalScrollMode="Disabled">
                                 <Grid x:Name="RawSignalProfileGrid"
                                       RowSpacing="{StaticResource ScanDebugInlineSpacing}"
                                       Padding="{StaticResource ScanDebugCardPadding}">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="*"/>
                                     </Grid.RowDefinitions>
                                     <TextBlock x:Name="RawSignalStatusTextBlock" Grid.Row="0"
                                               AutomationProperties.AutomationId="RawSignalStatusText"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{x:Bind ViewModel.RawSignalStatusText, Mode=OneWay}"
                                               TextWrapping="WrapWholeWords"
                                               Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                     <TextBox x:Name="RawSignalRowTextBox" Grid.Row="1"
                                             x:Uid="ScanDebug_RawSignalRowTextBox"
                                             AutomationProperties.AutomationId="RawSignalRowTextBox"
                                             InputScope="Number"
                                             Text="{x:Bind ViewModel.RawSignalRowInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                     <Grid x:Name="RawSignalResultDetails"
                                           Grid.Row="2"
                                           Visibility="Collapsed"
                                           RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="*"/>
                                             <RowDefinition Height="Auto"/>
                                         </Grid.RowDefinitions>
                                         <canvas:CanvasControl x:Name="RawSignalCanvasControl"
                                                               Grid.Row="0"
                                                               AutomationProperties.AutomationId="RawSignalCanvasControl"
                                                               AutomationProperties.AccessibilityView="Raw"
                                                               IsHitTestVisible="False"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch"
                                                               ClearColor="Transparent"
                                                              Tag="{x:Bind ViewModel.RawSignalResult, Mode=OneWay}"
                                                              CreateResources="RawSignalCanvasControl_CreateResources"
                                                              Draw="RawSignalCanvasControl_Draw"
                                                              SizeChanged="RawSignalCanvasControl_SizeChanged"
                                                              ActualThemeChanged="RawSignalCanvasControl_ActualThemeChanged"/>
                                         <Expander Grid.Row="1" IsExpanded="False"
                                                   AutomationProperties.AutomationId="RawSignalDetailsExpander">
                                             <Expander.Header>
                                                 <TextBlock x:Uid="ScanDebug_RawSignalDetailsTitle"/>
                                             </Expander.Header>
                                             <ScrollViewer MaxHeight="160"
                                                           VerticalScrollBarVisibility="Auto"
                                                           HorizontalScrollBarVisibility="Disabled">
                                                 <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                                     <TextBlock x:Uid="ScanDebug_RawSignalProfileAxis" TextWrapping="WrapWholeWords"/>
                                                     <TextBlock x:Uid="ScanDebug_RawSignalHistogramAxis" TextWrapping="WrapWholeWords"/>
                                                     <TextBlock x:Uid="ScanDebug_RawSignalSourceLabel" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                     <TextBlock AutomationProperties.AutomationId="RawSignalSourceText"
                                                                Text="{x:Bind ViewModel.RawSignalSourceText, Mode=OneWay}"
                                                                TextWrapping="WrapWholeWords"/>
                                                     <TextBlock x:Uid="ScanDebug_RawSignalStatisticsLabel" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                     <TextBlock AutomationProperties.AutomationId="RawSignalStatisticsText"
                                                                Text="{x:Bind ViewModel.RawSignalStatisticsText, Mode=OneWay}"
                                                                TextWrapping="WrapWholeWords"/>
                                                 </StackPanel>
                                             </ScrollViewer>
                                         </Expander>
                                     </Grid>
                                    <TextBlock x:Name="RawSignalAxisSwatch"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="RawSignalProfileSwatch"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="RawSignalHistogramSwatch"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="RawSignalGridSwatch"
                                               Foreground="{ThemeResource CardStrokeColorDefaultBrush}"
                                               Visibility="Collapsed"/>
                                 </Grid>
                             </ScrollViewer>
                             <Border x:Name="CursorReadoutBorder"
                                     Visibility="Collapsed"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     IsHitTestVisible="False"
                                     Padding="{StaticResource ScanDebugStatusPadding}"
                                     CornerRadius="{StaticResource ScanDebugCardCornerRadius}"
                                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                 <StackPanel Spacing="4">
                                     <TextBlock x:Name="CursorPositionTextBlock"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                     <TextBlock x:Name="CursorIntensityTextBlock"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                 </StackPanel>
                             </Border>
                         </Grid>
                    </Border>

                </Grid>
            </Border>
            <Border x:Name="WorkbenchInspectionRail"
                    Grid.Row="0"
                    Grid.Column="4"
                    AutomationProperties.AutomationId="WorkbenchInspectionRail"
                    AutomationProperties.AccessibilityView="Control"
                    Style="{StaticResource ScanDebugSectionCardStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="{StaticResource ScanDebugSectionSpacing}">
                        <TextBlock x:Uid="ScanDebug_WorkbenchInspectionTitle"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                         <TextBlock Text="{x:Bind ViewModel.FilmProfileDeviceStatusText, Mode=OneWay}"
                                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                         <TextBlock Text="{x:Bind ViewModel.FilmProfileHardwareUnavailableReasonText, Mode=OneWay}"
                                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                         <StackPanel x:Name="RawSignalInspectionDetails"
                                     Visibility="Collapsed"
                                     Spacing="{StaticResource ScanDebugInlineSpacing}">
                             <TextBlock x:Uid="ScanDebug_WorkbenchInspectionRawReadoutsTitle"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                             <TextBlock x:Name="RawSignalInspectionMeanText"
                                        AutomationProperties.AutomationId="RawSignalInspectionMeanText"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                             <TextBlock x:Name="RawSignalInspectionRangeText"
                                        AutomationProperties.AutomationId="RawSignalInspectionRangeText"/>
                             <TextBlock x:Name="RawSignalInspectionSamplesText"
                                        AutomationProperties.AutomationId="RawSignalInspectionSamplesText"/>
                         </StackPanel>
                         <TextBlock x:Uid="ScanDebug_WorkbenchInspectionRoiTitle"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.RoiStatusText, Mode=OneWay}"
                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                        <TextBlock x:Uid="ScanDebug_WorkbenchInspectionColumnTitle"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                         <TextBlock Text="{x:Bind ViewModel.ColumnSampleStatusText, Mode=OneWay}"
                                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                         <TextBlock x:Uid="ScanDebug_WorkbenchInspectionCaptureSourceLabel"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                         <TextBlock Text="{x:Bind ViewModel.CaptureSourceText, Mode=OneWay}"
                                    MaxLines="2" TextTrimming="WordEllipsis"
                                    TextWrapping="WrapWholeWords"
                                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                         <TextBlock x:Uid="ScanDebug_WorkbenchInspectionCaptureComparisonLabel"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                         <TextBlock AutomationProperties.AutomationId="CaptureComparisonText"
                                    AutomationProperties.Name="{x:Bind ViewModel.CaptureComparisonText, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.CaptureComparisonText, Mode=OneWay}"
                                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                    TextWrapping="WrapWholeWords"/>
                         <Expander IsExpanded="False"
                                   AutomationProperties.AutomationId="InspectionEvidenceExpander">
                             <Expander.Header>
                                 <TextBlock x:Uid="ScanDebug_WorkbenchInspectionEvidenceTitle"/>
                             </Expander.Header>
                             <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                 <TextBlock x:Uid="ScanDebug_WorkbenchInspectionSource" Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                 <TextBlock AutomationProperties.AutomationId="CaptureSourceText"
                                            Text="{x:Bind ViewModel.CaptureSourceText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords"/>
                                 <TextBlock x:Uid="ScanDebug_WorkbenchInspectionDeviceEvidenceLabel" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                 <TextBlock AutomationProperties.AutomationId="DeviceEvidenceText"
                                            Text="{x:Bind ViewModel.DeviceEvidenceText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords"/>
                             </StackPanel>
                         </Expander>
                        <Button x:Uid="ScanDebug_WorkbenchInspectionEditButton"
                                HorizontalAlignment="Left"
                                Click="OpenBlackWhiteTaskButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
        <Border Grid.Row="3"
                 Padding="{StaticResource ScanDebugStatusPadding}"
                 Style="{StaticResource ScanDebugSectionCardStyle}">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
        </Border>
    </Grid>
</Page>
