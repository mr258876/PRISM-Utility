                                                 Grid.Column="0"
                                                 x:Uid="ScanDebug_Motor3SpeedValueTextBox"
                                                  Text="{x:Bind ViewModel.Motor3SpeedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                         <ComboBox Grid.Row="1"
                                                   Grid.Column="1"
                                                   x:Uid="ScanDebug_Motor3SpeedUnitComboBox"
                                                   ItemsSource="{x:Bind ViewModel.MotorUnitOptions, Mode=OneWay}"
                                                   SelectedItem="{x:Bind ViewModel.Motor3SpeedUnit, Mode=TwoWay}"/>
                                     </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.Motor3MoveSummaryText, Mode=OneWay}"
                                               Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                     <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                                          RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Grid.Column="0"
                                                x:Uid="ScanDebug_Motor3MoveButton"
                                                Command="{x:Bind ViewModel.MoveMotorCommand}"
                                                CommandParameter="3"/>
                                        <Button Grid.Row="0"
                                                Grid.Column="1"
                                                x:Uid="ScanDebug_Motor3StopButton"
                                                Command="{x:Bind ViewModel.StopMotorCommand}"
                                                CommandParameter="3"/>
                                         <Button Grid.Row="1"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 x:Uid="ScanDebug_Motor3ApplyConfigButton"
                                                 Command="{x:Bind ViewModel.ApplyMotorConfigCommand}"
                                                 CommandParameter="3"/>
                                     </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.Motor3ApplyConfigEffectText, Mode=OneWay}"
                                               Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                 </StackPanel>
                             </Border>
                        </StackPanel>
                    </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <primitives:Thumb
                x:Name="PreviewSplitter"
                Grid.Row="0"
                Grid.Column="1"
                x:Uid="ScanDebug_PreviewSplitter"
                AutomationProperties.AutomationId="PreviewSplitter"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsTabStop="True"
                DragDelta="PreviewSplitter_DragDelta"
                KeyDown="PreviewSplitter_KeyDown"
                Visibility="Collapsed"/>

            <Border
                x:Name="WorkbenchPreviewColumnContent"
                Grid.Row="0"
                Grid.Column="2"
                AutomationProperties.AutomationId="WorkbenchPreviewColumnContent"
                AutomationProperties.AccessibilityView="Control"
                Style="{StaticResource ScanDebugSectionCardStyle}">
                <Grid RowSpacing="{StaticResource ScanDebugSectionSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   x:Uid="ScanDebug_Preview"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <controls:WrapPanel
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                            VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                            <Button x:Name="BackToEditorButton"
                                    x:Uid="ScanDebug_BackToEditorButton"
                                    AutomationProperties.AutomationId="BackToEditorButton"
                                    Click="BackToEditorButton_Click"
                                    Visibility="Collapsed"/>
                            <Button Content="-"
                                    Click="ZoomOutButton_Click"/>
                            <Button Content="+"
                                    Click="ZoomInButton_Click"/>
                            <ComboBox
                                x:Name="ZoomScaleComboBox"
                                Width="120"
                                SelectionChanged="ZoomScaleComboBox_SelectionChanged"/>
                            <ToggleSwitch
                                x:Uid="ScanDebug_WaterfallToggleSwitch"
                                IsEnabled="{x:Bind ViewModel.CanEditWaterfall, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.IsWaterfallEnabled, Mode=TwoWay}"/>
                            <ToggleSwitch
                                x:Name="PreviewGammaToggleSwitch"
                                x:Uid="ScanDebug_PreviewGammaToggleSwitch"
                                AutomationProperties.AutomationId="PreviewGammaToggleSwitch"
                                IsOn="{x:Bind ViewModel.IsGammaCorrectionEnabled, Mode=TwoWay}"/>
                            <TextBox
                                x:Name="PreviewGammaTextBox"
                                x:Uid="ScanDebug_PreviewGammaTextBox"
                                AutomationProperties.AutomationId="PreviewGammaTextBox"
                                Width="120"
                                IsEnabled="{x:Bind ViewModel.IsGammaCorrectionEnabled, Mode=OneWay}"
                                Text="{x:Bind ViewModel.PreviewGamma, Mode=TwoWay}"/>
                            <Button x:Uid="ScanDebug_PreviewDisplayToolsButton"
                                    AutomationProperties.AutomationId="PreviewDisplayToolsButton">
                                <Button.Flyout>
                                    <Flyout x:Name="PreviewDisplayToolsFlyout"
                                            FlyoutPresenterStyle="{StaticResource ScanDebugLocalFlyoutPresenterBaseStyle}"
                                            Opening="PreviewDisplayToolsFlyout_Opening">
                                        <ScrollViewer x:Name="PreviewDisplayToolsScrollViewer"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      HorizontalScrollMode="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      VerticalScrollMode="Auto">
                                            <StackPanel x:Name="PreviewDisplayToolsContent"
                                                        x:Load="False"
                                                        Spacing="{StaticResource ScanDebugInlineSpacing}">
                                                <TextBlock x:Uid="ScanDebug_PreviewDisplayToolsDescription"
                                                            Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                                <StackPanel x:Name="WaterfallPreviewOptionsPanel"
                                                            Spacing="{StaticResource ScanDebugInlineSpacing}"
                                                            Visibility="{x:Bind ViewModel.WaterfallPreviewOptionsVisibility, Mode=OneWay}">
                                                    <ToggleSwitch
                                                        x:Uid="ScanDebug_WaterfallCompressionToggleSwitch"
                                                        IsOn="{x:Bind ViewModel.IsWaterfallCompressedEnabled, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Uid="ScanDebug_WhiteLevelPreviewToggleSwitch"
                                                    IsOn="{x:Bind ViewModel.IsWhiteLevelPreviewEnabled, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Uid="ScanDebug_OverlayToolsButton"
                                    AutomationProperties.AutomationId="OverlayToolsButton">
                                <Button.Flyout>
                                    <Flyout x:Name="OverlayToolsFlyout"
                                            FlyoutPresenterStyle="{StaticResource ScanDebugLocalFlyoutPresenterBaseStyle}"
                                            Opening="OverlayToolsFlyout_Opening">
                                        <ScrollViewer x:Name="OverlayToolsScrollViewer"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      HorizontalScrollMode="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      VerticalScrollMode="Auto">
                                            <StackPanel x:Name="OverlayToolsContent"
                                                        x:Load="False"
                                                        AutomationProperties.AutomationId="OverlayToolsContent"
                                                        Spacing="{StaticResource ScanDebugInlineSpacing}">
                                                <TextBlock x:Uid="ScanDebug_OverlayVisibilityScopeDescription"
                                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                                           TextWrapping="WrapWholeWords"/>
                                                <TextBlock x:Uid="ScanDebug_VisibleOverlaysText"
                                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                                <controls:WrapPanel HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                                                    VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                                                    <CheckBox
                                                              x:Uid="ScanDebug_BwActiveOverlayCheckBox"
                                                              AutomationProperties.AutomationId="BwActiveOverlayCheckBox"
                                                              IsChecked="{x:Bind ViewModel.IsBwActiveRoiOverlayVisible, Mode=TwoWay}"/>
                                                    <CheckBox
                                                              x:Uid="ScanDebug_BwShieldOverlayCheckBox"
                                                              AutomationProperties.AutomationId="BwShieldOverlayCheckBox"
                                                              IsChecked="{x:Bind ViewModel.IsBwShieldRoiOverlayVisible, Mode=TwoWay}"/>
                                                    <CheckBox
                                                              x:Uid="ScanDebug_FocusOverallOverlayCheckBox"
                                                              AutomationProperties.AutomationId="FocusOverallOverlayCheckBox"
                                                              IsChecked="{x:Bind ViewModel.IsFocusOverallRoiOverlayVisible, Mode=TwoWay}"/>
                                                    <CheckBox
                                                              x:Uid="ScanDebug_FocusLeftOverlayCheckBox"
                                                              AutomationProperties.AutomationId="FocusLeftOverlayCheckBox"
                                                              IsChecked="{x:Bind ViewModel.IsFocusLeftRoiOverlayVisible, Mode=TwoWay}"/>
                                                    <CheckBox
                                                              x:Uid="ScanDebug_FocusRightOverlayCheckBox"
                                                              AutomationProperties.AutomationId="FocusRightOverlayCheckBox"
                                                              IsChecked="{x:Bind ViewModel.IsFocusRightRoiOverlayVisible, Mode=TwoWay}"/>
                                                    <CheckBox
                                                              x:Uid="ScanDebug_ImageReferenceOverlayCheckBox"
                                                              AutomationProperties.AutomationId="ImageReferenceOverlayCheckBox"
                                                              IsChecked="{x:Bind ViewModel.IsImageReferenceOverlayVisible, Mode=TwoWay}"/>
                                                </controls:WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </controls:WrapPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource ScanDebugCardBorderThickness}"
                        CornerRadius="{StaticResource ScanDebugCardCornerRadius}"
                        Padding="{StaticResource ScanDebugPreviewPadding}">
                        <Grid>
                            <ScrollViewer
                                x:Name="PreviewScrollViewer"
                                AutomationProperties.AutomationId="PreviewScrollViewer"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollMode="Enabled"
                                ZoomMode="Enabled"
                                MinZoomFactor="0.1"
                                MaxZoomFactor="20"
                                SizeChanged="PreviewScrollViewer_SizeChanged"
                                ViewChanged="PreviewScrollViewer_ViewChanged"
                                     PointerPressed="PreviewScrollViewer_PointerPressed"
                                     PointerMoved="PreviewScrollViewer_PointerMoved"
                                     PointerReleased="PreviewScrollViewer_PointerReleased"
                                     PointerCanceled="PreviewScrollViewer_PointerCanceled"
                                     PointerCaptureLost="PreviewScrollViewer_PointerCaptureLost"
                                     PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged">
                                <Canvas x:Name="PreviewCanvas">
                                     <canvas:CanvasControl
                                         x:Name="PreviewCanvasControl"
                                         AutomationProperties.AutomationId="PreviewCanvasControl"
                                         AutomationProperties.AccessibilityView="Control"
                                         ClearColor="Transparent"
                                        CreateResources="PreviewCanvasControl_CreateResources"
                                        Draw="PreviewCanvasControl_Draw"
                                        PointerPressed="PreviewCanvasControl_PointerPressed"
                                         PointerMoved="PreviewCanvasControl_PointerMoved"
                                         PointerReleased="PreviewCanvasControl_PointerReleased"
                                         PointerCanceled="PreviewCanvasControl_PointerCanceled"
                                         PointerCaptureLost="PreviewCanvasControl_PointerCaptureLost"
                                         PointerExited="PreviewCanvasControl_PointerExited"/>
                                    <Canvas x:Name="RoiCanvas"
                                            IsHitTestVisible="False"/>
                                    <Canvas x:Name="AxisCanvas"
                                            IsHitTestVisible="False"/>
                                </Canvas>
                            </ScrollViewer>
                            <Grid
                                x:Name="PreviewEmptyStateGrid"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="{StaticResource ScanDebugInlineSpacing}">
                                    <TextBlock x:Uid="ScanDebug_PreviewEmptyTitle"
                                               HorizontalAlignment="Center"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Uid="ScanDebug_PreviewEmptyDescription"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          ColumnSpacing="{StaticResource ScanDebugSectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{StaticResource ScanDebugInlineSpacing}">
                            <TextBlock x:Name="CursorPositionTextBlock"/>
                            <TextBlock x:Name="CursorIntensityTextBlock"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
