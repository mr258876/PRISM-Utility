<Page
    x:Class="PRISM_Utility.Views.ScanDebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:behaviors="using:PRISM_Utility.Behaviors"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:PRISM_Utility.Helpers"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:PRISM_Utility.Views"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:ScanSelectorDisplayNameConverter x:Key="ScanSelectorDisplayNameConverter"/>
        <Thickness x:Key="ScanDebugPagePadding">12</Thickness>
        <Thickness x:Key="ScanDebugCardPadding">12</Thickness>
        <Thickness x:Key="ScanDebugCompactCardPadding">8</Thickness>
        <Thickness x:Key="ScanDebugStatusPadding">8,4</Thickness>
        <Thickness x:Key="ScanDebugHeaderMargin">0,0,0,12</Thickness>
        <Thickness x:Key="ScanDebugPreviewPadding">0</Thickness>
        <Thickness x:Key="ScanDebugCardBorderThickness">1</Thickness>
        <CornerRadius x:Key="ScanDebugCardCornerRadius">8</CornerRadius>
        <x:Double x:Key="ScanDebugTightSpacing">4</x:Double>
        <x:Double x:Key="ScanDebugInlineSpacing">8</x:Double>
        <x:Double x:Key="ScanDebugSectionSpacing">12</x:Double>
        <x:Double x:Key="ScanDebugProfileNameMaximum">240</x:Double>
        <x:Double x:Key="ScanDebugReviewMaximumHeight">240</x:Double>
        <x:Double x:Key="ScanDebugCaptureMinimumWidth">180</x:Double>
        <x:Double x:Key="ScanDebugCaptureMaximumWidth">240</x:Double>
        <x:Double x:Key="ScanDebugFormMaximumWidth">960</x:Double>
        <x:Double x:Key="ScanDebugNumericFieldMaximumWidth">280</x:Double>
        <Style x:Key="ScanDebugPageTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugPanelTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugGroupTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugBodyStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugMetadataStyle" TargetType="TextBlock"
               BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <DataTemplate x:Key="ScanDebugExpanderStringHeaderTemplate">
            <TextBlock Text="{Binding}"
                       Style="{StaticResource ScanDebugGroupTitleStyle}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMotorOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=Motor}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDirectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=Direction}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanCalibrationChannelOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=CalibrationChannel}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMotorDirectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=MotorDirection}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMappedMotorDirectionOptionTemplate">
            <TextBlock Text="{Binding DisplayName}" ToolTipService.ToolTip="{Binding Token}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMotorRateUnitTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=MotorRateUnit}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMotorUnitTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=MotorUnit}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanRoiSelectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=RoiSelection}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDngExportModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=DngExportMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ProfileDngExportModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=ProfileDngExportMode}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAlignmentModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=AlignmentMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanCaptureModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=CaptureMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAutofocusPresetOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=AutofocusPreset}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAutofocusPresetStringOptionTemplate">
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugWrappingButtonContentTemplate">
            <TextBlock Text="{Binding}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugWrappingToggleHeaderTemplate">
            <TextBlock Text="{Binding}"
                        TextWrapping="WrapWholeWords"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugExternalFieldHeaderTemplate">
            <Grid/>
        </DataTemplate>
        <DataTemplate x:Key="FilmProfileNavigableValidationIssueTemplate">
            <Button Command="{Binding DataContext.NavigateToCurrentFilmProfileValidationIssueCommand, ElementName=ScanDebugRootGrid}"
                    CommandParameter="{Binding}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    ToolTipService.ToolTip="{Binding Message}"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"
                            ToolTipService.ToolTip="{Binding Message}">
                    <TextBlock Text="{Binding FieldDisplayName}"
                               Style="{StaticResource ScanDebugGroupTitleStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource ScanDebugBodyStyle}"
                               TextWrapping="WrapWholeWords"/>
                    <TextBlock x:Uid="ScanDebug_ValidationLocateAction"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="FilmProfilePassiveValidationIssueTemplate">
            <ContentControl AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            AutomationProperties.AccessibilityView="Content"
                            IsTabStop="False">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource ScanDebugCardBorderThickness}"
                        CornerRadius="{StaticResource ScanDebugCardCornerRadius}"
                        Padding="8">
                    <StackPanel Spacing="4"
                                ToolTipService.ToolTip="{Binding FieldPath}">
                        <TextBlock Text="{Binding Message}"
                                   TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="{Binding FieldDisplayName}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ContentControl>
        </DataTemplate>
        <views:FilmProfileValidationIssueTemplateSelector
            x:Key="FilmProfileValidationIssueTemplateSelector"
            NavigableTemplate="{StaticResource FilmProfileNavigableValidationIssueTemplate}"
            PassiveTemplate="{StaticResource FilmProfilePassiveValidationIssueTemplate}"/>
        <DataTemplate x:Key="FilmProfileBwNavigableValidationIssueTemplate">
            <Button Click="BwIssueButton_Click"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.HelpText="{Binding SourceSeverityText}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"
                            ToolTipService.ToolTip="{Binding FieldPath}">
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="WrapWholeWords"/>
                    <TextBlock Text="{Binding FieldDisplayName}"
                               Style="{StaticResource ScanDebugMetadataStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SourceSeverityText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <TextBlock x:Uid="ScanDebug_BwLocateIssueAction"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="FilmProfileBwPassiveValidationIssueTemplate">
            <StackPanel Spacing="4">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource FilmProfilePassiveValidationIssueTemplate}"/>
                <TextBlock Text="{Binding SourceSeverityText}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </DataTemplate>
        <views:FilmProfileValidationIssueTemplateSelector
            x:Key="FilmProfileBwIssueTemplateSelector"
            NavigableTemplate="{StaticResource FilmProfileBwNavigableValidationIssueTemplate}"
            PassiveTemplate="{StaticResource FilmProfileBwPassiveValidationIssueTemplate}"/>
        <Style x:Key="ScanDebugSectionCardStyle"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness"
                    Value="{StaticResource ScanDebugCardBorderThickness}"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource ScanDebugCardCornerRadius}"/>
            <Setter Property="Padding"
                    Value="{StaticResource ScanDebugCardPadding}"/>
            <Setter Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>
        <Style x:Key="ScanDebugQuietTextBlockStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource ScanDebugBodyStyle}">
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping"
                    Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugChannelLibraryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualPrimaryBrush"
                    Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="FocusVisualSecondaryBrush"
                    Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="FocusVisualPrimaryThickness"
                    Value="3"/>
            <Setter Property="FocusVisualSecondaryThickness"
                    Value="1"/>
            <Setter Property="FocusVisualMargin"
                    Value="2"/>
        </Style>
        <Style x:Key="ScanDebugLocalFlyoutPresenterBaseStyle"
               TargetType="FlyoutPresenter"
               BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="ScrollViewer.HorizontalScrollMode"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
        </Style>
    </Page.Resources>
    <Grid
        x:Name="ScanDebugRootGrid"
        AutomationProperties.AutomationId="ScanDebugRootGrid"
        DataContext="{x:Bind ViewModel}"
        Margin="{StaticResource ScanDebugPagePadding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="{StaticResource ScanDebugInlineSpacing}"
        SizeChanged="ScanDebugRootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border
             x:Name="FilmProfileLifecycleHeader"
            x:Uid="ScanDebug_FilmProfileLifecycleHeader"
             Grid.Row="0"
             AutomationProperties.AutomationId="FilmProfileLifecycleHeader"
             AutomationProperties.AccessibilityView="Control"
             Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                 <Grid Grid.Row="0"
                       ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                       RowSpacing="{StaticResource ScanDebugTightSpacing}">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                     <Grid x:Name="WorkbenchIdentityGrid"
                           Grid.Row="0"
                          ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                          RowSpacing="{StaticResource ScanDebugInlineSpacing}">


                          <TextBlock x:Name="WorkbenchTitleTextBlock"
                                     x:Uid="ScanDebug_WorkstationTitle"
                                     VerticalAlignment="Center"
                                      Style="{StaticResource ScanDebugPageTitleStyle}"
                                      TextWrapping="WrapWholeWords"/>

                    </Grid>
<Grid x:Name="WorkbenchProfileSummaryGrid"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                               RowSpacing="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                             <controls:WrapPanel Grid.ColumnSpan="2"
                                                 HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                                 VerticalSpacing="4">
                                <TextBlock Text="{x:Bind ViewModel.CurrentProfileNameText, Mode=OneWay}"
                                           Style="{StaticResource ScanDebugBodyStyle}"
                                           TextWrapping="NoWrap"
                                           MaxWidth="{StaticResource ScanDebugProfileNameMaximum}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.CurrentProfileNameText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="CurrentProfileFileNameText"/>
                                <Button x:Uid="ScanDebug_ProfileSaveStateButton"
                                        Padding="4,0" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ProfileSaveStateText, Mode=OneWay}"
                                               Style="{StaticResource ScanDebugMetadataStyle}"
                                               AutomationProperties.AutomationId="ProfileSaveStateText"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel MaxWidth="340" Spacing="8">
                                                <TextBlock x:Uid="ScanDebug_SaveScopeDraftText" Style="{StaticResource ScanDebugBodyStyle}"/>
                                                <TextBlock x:Uid="ScanDebug_SaveScopeLibraryText" Style="{StaticResource ScanDebugBodyStyle}"/>
                                                <TextBlock x:Uid="ScanDebug_SaveScopeConfigurationText" Style="{StaticResource ScanDebugBodyStyle}"/>
                                                <TextBlock x:Uid="ScanDebug_SaveScopeDeviceText" Style="{StaticResource ScanDebugBodyStyle}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="WorkbenchValidationButton"
                                        AutomationProperties.AutomationId="WorkbenchValidationButton"
                                        AutomationProperties.Name="{x:Bind ViewModel.WorkbenchParameterStatusText, Mode=OneWay}"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.WorkbenchParameterDetailText, Mode=OneWay}"
                                        TabIndex="30"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Content="{x:Bind ViewModel.WorkbenchParameterStatusText, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.WorkbenchParameterDetailText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ValidateFilmProfileCommand}"/>
                                <Button x:Name="WorkbenchCalibrationStatusButton"
                                        AutomationProperties.AutomationId="WorkbenchCalibrationStatusButton"
                                        AutomationProperties.Name="{x:Bind ViewModel.WorkbenchCalibrationStatusText, Mode=OneWay}"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.WorkbenchCalibrationDetailText, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.WorkbenchCalibrationDetailText, Mode=OneWay}"
                                        Content="{x:Bind ViewModel.WorkbenchCalibrationStatusText, Mode=OneWay}"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Click="OpenBlackWhiteTaskButton_Click"/>

                            <controls:WrapPanel x:Name="FilmProfileWorkflowGuide"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="FilmProfileWorkflowGuide"
                                HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                VerticalSpacing="4">
                <Button x:Name="FilmProfileWorkflowNextButton"
                             AutomationProperties.AutomationId="FilmProfileWorkflowNextButton"
                             AutomationProperties.Name="{x:Bind ViewModel.WorkflowGuideTitle, Mode=OneWay}"
                             AutomationProperties.HelpText="{x:Bind ViewModel.WorkflowGuideDetail, Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind ViewModel.WorkflowGuideDetail, Mode=OneWay}"
                             Padding="8,4"
                             Background="Transparent"
                             BorderThickness="0"
                             Click="FilmProfileWorkflowNextButton_Click"
                            >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.WorkflowGuideTitle, Mode=OneWay}"
                                   AutomationProperties.AutomationId="FilmProfileWorkflowTitle"
                                   AutomationProperties.LiveSetting="Polite"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ScanDebugBodyStyle}"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="FilmProfileWorkflowFlyout"
                                FlyoutPresenterStyle="{StaticResource ScanDebugLocalFlyoutPresenterBaseStyle}">
                            <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}" MaxWidth="340">
                                <TextBlock Text="{x:Bind ViewModel.WorkflowGuideTitle, Mode=OneWay}" Style="{StaticResource ScanDebugGroupTitleStyle}"/>
                                <TextBlock x:Uid="ScanDebug_FilmProfileWorkflowMenuTitle"
                                           Style="{StaticResource ScanDebugGroupTitleStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.WorkflowGuideDetail, Mode=OneWay}"
                                           AutomationProperties.AutomationId="FilmProfileWorkflowDetail"
                                           Style="{StaticResource ScanDebugMetadataStyle}"/>
                                <Button x:Name="FilmProfileWorkflowConfigurationStepButton"
                                        x:Uid="ScanDebug_FilmProfileWorkflowConfigurationStepButton"
                                        AutomationProperties.AutomationId="FilmProfileWorkflowConfigurationStepButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Tag="Configuration"
                                        Click="FilmProfileWorkflowStepButton_Click"/>
                                <Button x:Name="FilmProfileWorkflowCalibrationStepButton"
                                        x:Uid="ScanDebug_FilmProfileWorkflowCalibrationStepButton"
                                        AutomationProperties.AutomationId="FilmProfileWorkflowCalibrationStepButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Tag="Calibration"
                                        Click="FilmProfileWorkflowStepButton_Click"/>
                                <Button x:Name="FilmProfileWorkflowReviewStepButton"
                                        x:Uid="ScanDebug_FilmProfileWorkflowReviewStepButton"
                                        AutomationProperties.AutomationId="FilmProfileWorkflowReviewStepButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Tag="Review"
                                        Click="FilmProfileWorkflowStepButton_Click"/>
                                <Button x:Name="FilmProfileWorkflowScanStepButton"
                                        x:Uid="ScanDebug_FilmProfileWorkflowScanStepButton"
                                        AutomationProperties.AutomationId="FilmProfileWorkflowScanStepButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Tag="Scan"
                                        Click="FilmProfileWorkflowStepButton_Click"/>
                                <TextBlock x:Uid="ScanDebug_FilmProfileWorkflowNavigationScopeText"
                                           Style="{StaticResource ScanDebugMetadataStyle}"/>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </controls:WrapPanel>
                            </controls:WrapPanel>
                        </Grid>

                     <controls:WrapPanel x:Name="FilmProfileLifecycleActionsPanel"
                                         Grid.Column="1"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                         VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                          <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" VerticalAlignment="Center">
                              <Button x:Name="ConfigurationFileMenuButton" x:Uid="ScanDebug_WorkbenchConfigurationOperationsButton"
                                  AutomationProperties.AutomationId="ConfigurationFileMenuButton"
                                  TabIndex="10">
                              <Button.Flyout>
                                  <MenuFlyout x:Name="ConfigurationFileFlyout"
                                              Placement="BottomEdgeAlignedLeft">
                                      <MenuFlyoutItem x:Uid="ScanDebug_ConfigurationFileNewItem"
                                                      Command="{x:Bind ViewModel.NewFilmProfileCommand}">
                                          <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add"/></MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutItem x:Uid="ScanDebug_ConfigurationFileOpenItem"
                                                      Command="{x:Bind ViewModel.LoadFilmProfileJsonCommand}">
                                          <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile"/></MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutItem x:Name="SaveConfigurationFileButton"
                                                      x:Uid="ScanDebug_ConfigurationFileSaveItem"
                                                      AutomationProperties.AutomationId="SaveConfigurationFileButton"
                                                      Command="{x:Bind ViewModel.SaveFilmProfileJsonCommand}">
                                          <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save"/></MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutSeparator/>
                                      <MenuFlyoutItem x:Name="LoadFilmProfileDraftButton"
                                                      x:Uid="ScanDebug_ConfigurationDraftOpenItem"
                                                      AutomationProperties.AutomationId="LoadFilmProfileDraftButton"
                                                      IsEnabled="{x:Bind ViewModel.CanUseEditingDraftFiles, Mode=OneWay}"
                                                      Click="LoadFilmProfileDraftButton_Click"/>
                                      <MenuFlyoutSeparator/>
                                      <MenuFlyoutItem x:Uid="ScanDebug_ConfigurationPropertiesItem"
                                                      AutomationProperties.AutomationId="WorkbenchConfigurationButton"
                                                      Click="OpenConfigurationButton_Click">
                                          <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit"/></MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                  </MenuFlyout>
                              </Button.Flyout>
                          </Button>
<Button x:Name="SaveFilmProfileDraftButton"
                                                  x:Uid="ScanDebug_SaveFilmProfileDraftButton"
                                                  AutomationProperties.AutomationId="SaveFilmProfileDraftButton"
                                                  TabIndex="15"
                                                  IsEnabled="{x:Bind ViewModel.CanUseEditingDraftFiles, Mode=OneWay}"
                                                  Click="SaveCurrentConfigurationButton_Click"/>

                              <Button x:Name="SaveAndOpenScanButton"
                                      x:Uid="ScanDebug_SaveAndOpenScanButton"
                                      AutomationProperties.AutomationId="SaveAndOpenScanButton"
                                      TabIndex="16"
                                      Style="{StaticResource AccentButtonStyle}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.FilmProfileSaveHintText, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.CanSaveFilmProfileFile, Mode=OneWay}"
                                      Click="SaveAndOpenScanButton_Click"/>
                          </controls:WrapPanel>
                    </controls:WrapPanel>
                </Grid>




            </Grid>
        </Border>

         <Grid x:Name="WorkbenchWorkspaceGrid" Grid.Row="1" RowSpacing="{StaticResource ScanDebugTightSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

         <Grid x:Name="WorkbenchWorkspaceHeader"
               Grid.Row="0"
               ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
               RowSpacing="{StaticResource ScanDebugInlineSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
                    <StackPanel x:Name="WorkbenchAuxiliaryHeader"
                            AutomationProperties.AutomationId="WorkbenchAuxiliaryHeader"
                            Spacing="8" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkbenchAuxiliaryTitle" VerticalAlignment="Center"
                                   Style="{StaticResource ScanDebugPanelTitleStyle}"/>
                        <Button x:Name="ReturnToWorkbenchTaskButton" Grid.Column="1"
                                x:Uid="ScanDebug_ReturnToWorkbenchTaskButton"
                                AutomationProperties.AutomationId="ReturnToWorkbenchTaskButton"
                                Click="ReturnToWorkbenchTaskButton_Click"/>
                    </Grid>
                    <SelectorBar x:Name="WorkbenchSectionSelectorBar"
                            AutomationProperties.AutomationId="WorkbenchSectionSelectorBar"
                            SelectionChanged="WorkbenchSectionSelectorBar_SelectionChanged"
                            Visibility="Collapsed">
                            <SelectorBarItem x:Uid="ScanDebug_PropertiesGeneralTab"/>
                            <SelectorBarItem x:Uid="ScanDebug_PropertiesDeviceTab"/>
                            <SelectorBarItem x:Name="PropertiesEngineeringTab"
                                             x:Uid="ScanDebug_PropertiesEngineeringTab"
                                             AutomationProperties.AutomationId="PropertiesEngineeringTab"/>
                        </SelectorBar>
                </StackPanel>
             <SelectorBar x:Name="WorkbenchTaskSelectorBar"
                          Grid.Column="0"
                          AutomationProperties.AutomationId="WorkbenchTaskSelectorBar"
                          HorizontalAlignment="Left"
                          SelectionChanged="WorkbenchTaskSelectorBar_SelectionChanged">
                 <SelectorBarItem x:Name="SamplingTaskButton" Tapped="WorkbenchTaskButton_Tapped" x:Uid="ScanDebug_WorkbenchSamplingTaskButton" AutomationProperties.AutomationId="WorkbenchSamplingTaskButton" IsSelected="True"/>
