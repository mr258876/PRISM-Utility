<Page
    x:Class="PRISM_Utility.Views.ScanDebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:behaviors="using:PRISM_Utility.Behaviors"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:PRISM_Utility.Helpers"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:ScanSelectorDisplayNameConverter x:Key="ScanSelectorDisplayNameConverter"/>
        <Thickness x:Key="ScanDebugPagePadding">12,12,12,24</Thickness>
        <Thickness x:Key="ScanDebugCardPadding">12</Thickness>
        <Thickness x:Key="ScanDebugHeaderMargin">0,0,0,12</Thickness>
        <Thickness x:Key="ScanDebugPreviewPadding">0</Thickness>
        <Thickness x:Key="ScanDebugCardBorderThickness">1</Thickness>
        <CornerRadius x:Key="ScanDebugCardCornerRadius">8</CornerRadius>
        <x:Double x:Key="ScanDebugInlineSpacing">8</x:Double>
        <x:Double x:Key="ScanDebugSectionSpacing">12</x:Double>
        <DataTemplate x:Key="ScanMotorOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=Motor}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDirectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=Direction}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanCalibrationChannelOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=CalibrationChannel}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMotorDirectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=MotorDirection}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanRoiSelectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=RoiSelection}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDngExportModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=DngExportMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ProfileDngExportModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=ProfileDngExportMode}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAlignmentModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=AlignmentMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanCaptureModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=CaptureMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAutofocusPresetOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=AutofocusPreset}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAutofocusPresetStringOptionTemplate">
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugWrappingButtonContentTemplate">
            <TextBlock Text="{Binding}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugWrappingToggleHeaderTemplate">
            <TextBlock Text="{Binding}"
                       TextWrapping="WrapWholeWords"/>
        </DataTemplate>
        <Style x:Key="ScanDebugSectionCardStyle"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness"
                    Value="{StaticResource ScanDebugCardBorderThickness}"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource ScanDebugCardCornerRadius}"/>
            <Setter Property="Padding"
                    Value="{StaticResource ScanDebugCardPadding}"/>
            <Setter Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>
        <Style x:Key="ScanDebugQuietTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping"
                    Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugChannelLibraryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualPrimaryBrush"
                    Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="FocusVisualSecondaryBrush"
                    Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="FocusVisualPrimaryThickness"
                    Value="3"/>
            <Setter Property="FocusVisualSecondaryThickness"
                    Value="1"/>
            <Setter Property="FocusVisualMargin"
                    Value="2"/>
        </Style>
        <Style x:Key="ScanDebugLocalFlyoutPresenterBaseStyle"
               TargetType="FlyoutPresenter"
               BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="ScrollViewer.HorizontalScrollMode"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
        </Style>
    </Page.Resources>
    <Grid
        x:Name="ScanDebugRootGrid"
        DataContext="{x:Bind ViewModel}"
        Margin="{StaticResource ScanDebugPagePadding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="{StaticResource ScanDebugSectionSpacing}"
        SizeChanged="ScanDebugRootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            x:Name="FilmProfileLifecycleHeader"
            x:Uid="ScanDebug_FilmProfileLifecycleHeader"
            Grid.Row="0"
            AutomationProperties.AutomationId="FilmProfileLifecycleHeader"
            AutomationProperties.AccessibilityView="Control"
            Margin="{StaticResource ScanDebugHeaderMargin}"
            Style="{StaticResource ScanDebugSectionCardStyle}">
            <StackPanel Spacing="{StaticResource ScanDebugSectionSpacing}">
                <Grid ColumnSpacing="{StaticResource ScanDebugSectionSpacing}"
                      RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Spacing="{StaticResource ScanDebugInlineSpacing}">
                        <TextBlock
                            x:Uid="ScanDebug_WorkstationTitle"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            TextWrapping="WrapWholeWords"/>
                        <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                              RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       x:Uid="ScanDebug_FilmProfileWorkbenchCurrentConfigLabel"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.CurrentProfileNameText, Mode=OneWay}"
                                           TextWrapping="WrapWholeWords"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind ViewModel.ProfileSaveStateText, Mode=OneWay}"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       x:Uid="ScanDebug_FilmProfileWorkbenchDeviceStatusTitle"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.FilmProfileDeviceStatusText, Mode=OneWay}"
                                           TextWrapping="WrapWholeWords"/>
                                <TextBlock Text="{x:Bind ViewModel.FilmProfileHardwareUnavailableReasonText, Mode=OneWay}"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <controls:WrapPanel Grid.Row="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                        VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                        <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleNewButton"
                                TabIndex="10"
                                Command="{x:Bind ViewModel.NewFilmProfileCommand}"/>
                        <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleOpenJsonButton"
                                TabIndex="20"
                                Command="{x:Bind ViewModel.LoadFilmProfileJsonCommand}"/>
                        <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleValidateButton"
                                TabIndex="30"
                                Command="{x:Bind ViewModel.ValidateFilmProfileCommand}"/>
                        <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleSaveJsonButton"
                                TabIndex="40"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveFilmProfileJsonCommand}"/>
                        <Button x:Uid="ScanDebug_StopAllMotorsButton"
                                AutomationProperties.AutomationId="StopAllMotorsButton"
                                TabIndex="45"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Command="{x:Bind ViewModel.StopAllMotorsCommand}"
                                ContentTemplate="{StaticResource ScanDebugWrappingButtonContentTemplate}"/>
                    </controls:WrapPanel>
                </Grid>

                <InfoBar
                    x:Name="FilmProfileOperationInfoBar"
                    x:Uid="ScanDebug_FilmProfileWorkbenchOperationInfoBar"
                    AutomationProperties.AutomationId="FilmProfileOperationInfoBar"
                    IsOpen="{x:Bind ViewModel.FilmProfileOperationIsOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.FilmProfileOperationMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.FilmProfileOperationSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.FilmProfileOperationVisibility, Mode=OneWay}"/>

                <Border
                    x:Name="StagedFilmProfileImportReview"
                    x:Uid="ScanDebug_StagedFilmProfileImportReview"
                    AutomationProperties.AutomationId="StagedFilmProfileImportReview"
                    AutomationProperties.AccessibilityView="Control"
                    Style="{StaticResource ScanDebugSectionCardStyle}"
                    Visibility="{x:Bind ViewModel.FilmProfileImportResultReviewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportTitle"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportHelpText"
                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                        <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                              RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportNameLabel"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.StagedFilmProfileImportDisplayNameText, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportChannelsLabel"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.StagedFilmProfileImportChannelCountText, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords"/>
                        </Grid>
                        <InfoBar
                            x:Uid="ScanDebug_FilmProfileWorkbenchStagedValidationInfoBar"
                            MaxWidth="560"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.StagedFilmProfileImportValidationSummary, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.StagedFilmProfileImportSeverity, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.StagedFilmProfileDirtyReplacementWarningText, Mode=OneWay}"
                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                   TextWrapping="WrapWholeWords"
                                   Visibility="{x:Bind ViewModel.StagedFilmProfileDirtyReplacementWarningVisibility, Mode=OneWay}"/>
                        <controls:WrapPanel HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                            VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                             <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleDiscardStagedButton"
                                     TabIndex="50"
                                     Command="{x:Bind ViewModel.DiscardStagedFilmProfileImportCommand}"/>
                             <Button x:Uid="ScanDebug_FilmProfileWorkbenchImportChooseOtherFileButton"
                                     TabIndex="55"
                                     Command="{x:Bind ViewModel.LoadFilmProfileJsonCommand}"/>
                             <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleApplyStagedButton"
                                    TabIndex="60"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ApplyStagedFilmProfileImportCommand}"/>
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              ColumnSpacing="{StaticResource ScanDebugInlineSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="WorkbenchSectionSelectorBar"
                Grid.Column="0"
                AutomationProperties.AutomationId="WorkbenchSectionSelectorBar"
                HorizontalAlignment="Stretch"
                SelectionChanged="WorkbenchSectionSelectorBar_SelectionChanged">
                <SelectorBarItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionBasicInfo"
                                 IsSelected="True"/>
                <SelectorBarItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionAcquisitionPlan"/>
                <SelectorBarItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionChannelCalibrationSelector"/>
                <SelectorBarItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionLiveCalibration"/>
                <SelectorBarItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionDeviceSettings"/>
                <SelectorBarItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionEngineeringTools"/>
            </SelectorBar>
            <ComboBox
                x:Name="WorkbenchSectionComboBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="WorkbenchSectionComboBox"
                HorizontalAlignment="Stretch"
                MaxWidth="360"
                SelectedIndex="0"
                SelectionChanged="WorkbenchSectionComboBox_SelectionChanged"
                Visibility="Collapsed">
                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionBasicInfoComboBoxItem"/>
                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionAcquisitionPlanComboBoxItem"/>
                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionChannelCalibrationComboBoxItem"/>
                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionLiveCalibrationComboBoxItem"/>
                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionDeviceSettingsComboBoxItem"/>
                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchSectionEngineeringToolsComboBoxItem"/>
            </ComboBox>
            <Button x:Name="OpenPreviewButton"
                    Grid.Column="1"
                    x:Uid="ScanDebug_OpenPreviewButton"
                    AutomationProperties.AutomationId="OpenPreviewButton"
                    Click="OpenPreviewButton_Click"
                    Visibility="Collapsed"/>
        </Grid>

        <Grid
            x:Name="WorkbenchContentSplitGrid"
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.FilmProfileWorkbenchContentVisibility, Mode=OneWay}"
            ColumnSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkbenchEditorRow"
                               Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkbenchEditorColumn"
                                   Width="5*"/>
                <ColumnDefinition x:Name="WorkbenchPreviewSeparatorColumn"
                                  Width="12"/>
                <ColumnDefinition x:Name="WorkbenchPreviewColumn"
                                   Width="7*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="WorkbenchEditorColumnContent" Grid.Row="0" Grid.Column="0">
                <Grid>
                    <Grid x:Name="BasicInfoSection"
                          x:Uid="ScanDebug_BasicInfoSection"
                          AutomationProperties.AutomationId="BasicInfoSection"
                          AutomationProperties.AccessibilityView="Control"
                          Visibility="Collapsed">
                        <ScrollViewer x:Name="BasicInfoScrollViewer"
                            AutomationProperties.AutomationId="BasicInfoScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="{StaticResource ScanDebugSectionSpacing}">
                                <Border Style="{StaticResource ScanDebugSectionCardStyle}">
                                    <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchBasicMetadataTitle"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   TextWrapping="WrapWholeWords"/>
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchBasicMetadataDescription"
                                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                         <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                                               RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="ProfileNameTextBox"
                                                      Grid.Row="0"
                                                      Grid.Column="0"
                                                      Grid.ColumnSpan="2"
                                                      x:Uid="ScanDebug_FilmProfileWorkbenchBasicProfileNameTextBox"
                                                      AutomationProperties.AutomationId="ProfileNameTextBox"
                                                      Text="{x:Bind ViewModel.FilmProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                             <ComboBox x:Name="ProfileAlignmentModeComboBox"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       x:Uid="ScanDebug_ProfileAlignmentModeComboBox"
                                                       AutomationProperties.AutomationId="ProfileAlignmentModeComboBox"
                                                       ItemsSource="{x:Bind ViewModel.AlignmentModeOptions, Mode=OneWay}"
                                                       ItemTemplate="{StaticResource ScanAlignmentModeOptionTemplate}"
                                                       SelectedItem="{x:Bind ViewModel.SelectedProfileAlignmentMode, Mode=TwoWay}"/>
                                             <ComboBox x:Name="ProfileDngExportModeComboBox"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                        x:Uid="ScanDebug_ProfileDngExportModeComboBox"
                                                        AutomationProperties.AutomationId="ProfileDngExportModeComboBox"
                                                        AutomationProperties.Name="{x:Bind ViewModel.SelectedProfileDngExportModeAccessibleText, Mode=OneWay}"
                                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedProfileDngExportModeAccessibleText, Mode=OneWay}"
                                                       ItemsSource="{x:Bind ViewModel.DngExportModeOptions, Mode=OneWay}"
                                                       ItemTemplate="{StaticResource ProfileDngExportModeOptionTemplate}"
                                                       SelectedItem="{x:Bind ViewModel.SelectedProfileDngExportMode, Mode=TwoWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ScanDebugSectionCardStyle}">
                                    <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchBasicRecipeTitle"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   TextWrapping="WrapWholeWords"/>
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchBasicRecipeDescription"
                                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                        <ToggleSwitch x:Name="ProfileColorManagementToggleSwitch"
                                                      x:Uid="ScanDebug_FilmProfileWorkbenchBasicColorManagementToggleSwitch"
                                                      AutomationProperties.AutomationId="ProfileColorManagementToggleSwitch"
                                                      IsOn="{x:Bind ViewModel.IsScanRecipeColorManagementEnabled, Mode=TwoWay}"/>
                                        <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                                              RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="ProfileRedWavelengthTextBox"
                                                     Grid.Row="0"
                                                     Grid.Column="0"
                                                     x:Uid="ScanDebug_FilmProfileWorkbenchBasicRedWavelengthTextBox"
                                                     AutomationProperties.AutomationId="ProfileRedWavelengthTextBox"
                                                     IsEnabled="{x:Bind ViewModel.IsScanRecipeColorManagementEnabled, Mode=OneWay}"
                                                     Text="{x:Bind ViewModel.ScanRecipeRedWavelengthNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                             <TextBox x:Name="ProfileGreenWavelengthTextBox"
                                                      Grid.Row="0"
                                                      Grid.Column="1"
                                                      x:Uid="ScanDebug_FilmProfileWorkbenchBasicGreenWavelengthTextBox"
                                                      AutomationProperties.AutomationId="ProfileGreenWavelengthTextBox"
                                                      IsEnabled="{x:Bind ViewModel.IsScanRecipeColorManagementEnabled, Mode=OneWay}"
                                                      Text="{x:Bind ViewModel.ScanRecipeGreenWavelengthNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                             <TextBox x:Name="ProfileBlueWavelengthTextBox"
                                                      Grid.Row="1"
                                                      Grid.Column="0"
                                                      x:Uid="ScanDebug_FilmProfileWorkbenchBasicBlueWavelengthTextBox"
                                                      AutomationProperties.AutomationId="ProfileBlueWavelengthTextBox"
                                                      IsEnabled="{x:Bind ViewModel.IsScanRecipeColorManagementEnabled, Mode=OneWay}"
                                                      Text="{x:Bind ViewModel.ScanRecipeBlueWavelengthNm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                             <TextBox x:Name="ProfileOutputGammaTextBox"
                                                      Grid.Row="1"
                                                      Grid.Column="1"
                                                      x:Uid="ScanDebug_FilmProfileWorkbenchBasicOutputGammaTextBox"
                                                      AutomationProperties.AutomationId="ProfileOutputGammaTextBox"
                                                      IsEnabled="{x:Bind ViewModel.IsScanRecipeColorManagementEnabled, Mode=OneWay}"
                                                      Text="{x:Bind ViewModel.ScanRecipeOutputGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                             <ComboBox x:Name="ProfileTargetWhitePointComboBox"
                                                       Grid.Row="2"
                                                       Grid.Column="0"
                                                       x:Uid="ScanDebug_FilmProfileWorkbenchBasicTargetWhitePointComboBox"
                                                       AutomationProperties.AutomationId="ProfileTargetWhitePointComboBox"
                                                       IsEnabled="{x:Bind ViewModel.IsScanRecipeColorManagementEnabled, Mode=OneWay}"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{x:Bind ViewModel.SelectedScanRecipeTargetWhitePointMode, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchBasicTargetWhitePointD65ComboBoxItem"
                                                              Tag="D65"/>
                                                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchBasicTargetWhitePointD50ComboBoxItem"
                                                              Tag="D50"/>
                                                <ComboBoxItem x:Uid="ScanDebug_FilmProfileWorkbenchBasicTargetWhitePointManualComboBoxItem"
                                                              Tag="ManualColorTemperature"/>
                                            </ComboBox>
                                             <TextBox x:Name="ProfileManualWhitePointColorTemperatureTextBox"
                                                      Grid.Row="2"
                                                      Grid.Column="1"
                                                      x:Uid="ScanDebug_FilmProfileWorkbenchBasicManualWhitePointColorTemperatureTextBox"
                                                      AutomationProperties.AutomationId="ProfileManualWhitePointColorTemperatureTextBox"
                                                      IsEnabled="{x:Bind ViewModel.IsScanRecipeManualWhitePointColorTemperatureEnabled, Mode=OneWay}"
                                                     Text="{x:Bind ViewModel.ScanRecipeManualWhitePointColorTemperatureK, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,96"
                                        Style="{StaticResource ScanDebugSectionCardStyle}">
                                    <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchBasicValidationTitle"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   TextWrapping="WrapWholeWords"/>
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchBasicValidationDescription"
                                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                        <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                                              RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       x:Uid="ScanDebug_FilmProfileWorkspaceDirtyLabel"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{x:Bind ViewModel.ProfileSaveStateText, Mode=OneWay}"
                                                       TextWrapping="WrapWholeWords"/>
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       x:Uid="ScanDebug_FilmProfileWorkspaceValidationLabel"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{x:Bind ViewModel.CurrentFilmProfileValidationSummary, Mode=OneWay}"
                                                       Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                                        TextWrapping="Wrap"/>
                                        </Grid>
                                        <InfoBar x:Uid="ScanDebug_FilmProfileWorkbenchCurrentValidationTitle"
                                                 IsOpen="True"
                                                 Severity="{x:Bind ViewModel.CurrentFilmProfileValidationSeverity, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentFilmProfileValidationSummary, Mode=OneWay}"
                                                        TextWrapping="Wrap"/>
                                        </InfoBar>
                                     </StackPanel>
                                 </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="AcquisitionPlanSection"
                          x:Uid="ScanDebug_AcquisitionPlanSection"
                          AutomationProperties.AutomationId="AcquisitionPlanSection"
                          AutomationProperties.AccessibilityView="Control"
                          Visibility="Collapsed">
                        <ScrollViewer x:Name="AcquisitionPlanScrollViewer"
                            AutomationProperties.AutomationId="AcquisitionPlanScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto"
                            HorizontalScrollBarVisibility="Disabled"
