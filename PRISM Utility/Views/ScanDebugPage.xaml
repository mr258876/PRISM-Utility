<Page
    x:Class="PRISM_Utility.Views.ScanDebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:behaviors="using:PRISM_Utility.Behaviors"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:PRISM_Utility.Helpers"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:PRISM_Utility.Views"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:ScanSelectorDisplayNameConverter x:Key="ScanSelectorDisplayNameConverter"/>
        <Thickness x:Key="ScanDebugPagePadding">12,12,12,24</Thickness>
        <Thickness x:Key="ScanDebugCardPadding">12</Thickness>
        <Thickness x:Key="ScanDebugCompactCardPadding">8</Thickness>
        <Thickness x:Key="ScanDebugStatusPadding">8,4</Thickness>
        <Thickness x:Key="ScanDebugHeaderMargin">0,0,0,12</Thickness>
        <Thickness x:Key="ScanDebugPreviewPadding">0</Thickness>
        <Thickness x:Key="ScanDebugCardBorderThickness">1</Thickness>
        <CornerRadius x:Key="ScanDebugCardCornerRadius">8</CornerRadius>
        <x:Double x:Key="ScanDebugInlineSpacing">8</x:Double>
        <x:Double x:Key="ScanDebugSectionSpacing">12</x:Double>
        <x:Double x:Key="ScanDebugProfileNameMaximum">240</x:Double>
        <x:Double x:Key="ScanDebugReviewMaximumHeight">96</x:Double>
        <x:Double x:Key="ScanDebugCaptureMinimumWidth">180</x:Double>
        <x:Double x:Key="ScanDebugCaptureMaximumWidth">240</x:Double>
        <x:Double x:Key="ScanDebugIdentityCompactWidth">640</x:Double>
        <DataTemplate x:Key="ScanMotorOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=Motor}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDirectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=Direction}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanCalibrationChannelOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=CalibrationChannel}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanMotorDirectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=MotorDirection}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanRoiSelectionOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=RoiSelection}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDngExportModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=DngExportMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ProfileDngExportModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=ProfileDngExportMode}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAlignmentModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=AlignmentMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanCaptureModeOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=CaptureMode}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAutofocusPresetOptionTemplate">
            <TextBlock Text="{Binding Converter={StaticResource ScanSelectorDisplayNameConverter}, ConverterParameter=AutofocusPreset}"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanAutofocusPresetStringOptionTemplate">
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugWrappingButtonContentTemplate">
            <TextBlock Text="{Binding}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"/>
        </DataTemplate>
        <DataTemplate x:Key="ScanDebugWrappingToggleHeaderTemplate">
            <TextBlock Text="{Binding}"
                        TextWrapping="WrapWholeWords"/>
        </DataTemplate>
        <DataTemplate x:Key="FilmProfileNavigableValidationIssueTemplate">
            <Button Command="{Binding DataContext.NavigateToCurrentFilmProfileValidationIssueCommand, ElementName=ScanDebugRootGrid}"
                    CommandParameter="{Binding}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="4"
                            ToolTipService.ToolTip="{Binding FieldPath}">
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="WrapWholeWords"/>
                    <TextBlock Text="{Binding FieldPath}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="FilmProfilePassiveValidationIssueTemplate">
            <ContentControl AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            AutomationProperties.AccessibilityView="Content"
                            IsTabStop="False">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="{StaticResource ScanDebugCardBorderThickness}"
                        CornerRadius="{StaticResource ScanDebugCardCornerRadius}"
                        Padding="8">
                    <StackPanel Spacing="4"
                                ToolTipService.ToolTip="{Binding FieldPath}">
                        <TextBlock Text="{Binding Message}"
                                   TextWrapping="WrapWholeWords"/>
                        <TextBlock Text="{Binding FieldPath}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ContentControl>
        </DataTemplate>
        <views:FilmProfileValidationIssueTemplateSelector
            x:Key="FilmProfileValidationIssueTemplateSelector"
            NavigableTemplate="{StaticResource FilmProfileNavigableValidationIssueTemplate}"
            PassiveTemplate="{StaticResource FilmProfilePassiveValidationIssueTemplate}"/>
        <Style x:Key="ScanDebugSectionCardStyle"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness"
                    Value="{StaticResource ScanDebugCardBorderThickness}"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource ScanDebugCardCornerRadius}"/>
            <Setter Property="Padding"
                    Value="{StaticResource ScanDebugCardPadding}"/>
            <Setter Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>
        <Style x:Key="ScanDebugQuietTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping"
                    Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="ScanDebugChannelLibraryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualPrimaryBrush"
                    Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Setter Property="FocusVisualSecondaryBrush"
                    Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="FocusVisualPrimaryThickness"
                    Value="3"/>
            <Setter Property="FocusVisualSecondaryThickness"
                    Value="1"/>
            <Setter Property="FocusVisualMargin"
                    Value="2"/>
        </Style>
        <Style x:Key="ScanDebugLocalFlyoutPresenterBaseStyle"
               TargetType="FlyoutPresenter"
               BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="ScrollViewer.HorizontalScrollMode"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
        </Style>
    </Page.Resources>
    <Grid
        x:Name="ScanDebugRootGrid"
        AutomationProperties.AutomationId="ScanDebugRootGrid"
        DataContext="{x:Bind ViewModel}"
        Margin="{StaticResource ScanDebugPagePadding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="{StaticResource ScanDebugSectionSpacing}"
        SizeChanged="ScanDebugRootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border
             x:Name="FilmProfileLifecycleHeader"
            x:Uid="ScanDebug_FilmProfileLifecycleHeader"
             Grid.Row="0"
             AutomationProperties.AutomationId="FilmProfileLifecycleHeader"
             AutomationProperties.AccessibilityView="Control"
             Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                 <Grid Grid.Row="0"
                       ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                       RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                     <Grid x:Name="WorkbenchIdentityGrid"
                           Grid.Row="0"
                          ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                          RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         <TextBlock x:Name="WorkbenchTitleTextBlock"
                                    x:Uid="ScanDebug_WorkstationTitle"
                                    VerticalAlignment="Center"
                                     Style="{ThemeResource BodyStrongTextBlockStyle}"
                                     TextWrapping="WrapWholeWords"/>
                         <Grid x:Name="WorkbenchProfileSummaryGrid"
                               Grid.Column="1"
                               ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                               RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                             <controls:WrapPanel Grid.ColumnSpan="2"
                                                 HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                                 VerticalSpacing="4">
                                <TextBlock Text="{x:Bind ViewModel.CurrentProfileNameText, Mode=OneWay}"
                                           TextWrapping="NoWrap"
                                           MaxWidth="{StaticResource ScanDebugProfileNameMaximum}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.CurrentProfileNameText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind ViewModel.ProfileSaveStateText, Mode=OneWay}"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"
                                           TextTrimming="CharacterEllipsis"/>
                            </controls:WrapPanel>
                        </Grid>
                    </Grid>

                     <controls:WrapPanel x:Name="FilmProfileLifecycleActionsPanel"
                                         Grid.Column="1"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                         VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                         <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleSaveJsonButton"
                                 TabIndex="10"
                                 Command="{x:Bind ViewModel.SaveFilmProfileJsonCommand}"/>
                        <Button x:Uid="ScanDebug_WorkbenchConfigurationButton"
                                AutomationProperties.AutomationId="WorkbenchConfigurationButton"
                                TabIndex="20"
                                Click="OpenConfigurationButton_Click"/>
                        <Button x:Uid="ScanDebug_WorkbenchConfigurationOperationsButton"
                                TabIndex="30">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                        <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleNewButton"
                                                HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.NewFilmProfileCommand}"/>
                                        <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleOpenJsonButton"
                                                HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.LoadFilmProfileJsonCommand}"/>
                                         <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleValidateButton"
                                                 HorizontalAlignment="Stretch"
                                                 Command="{x:Bind ViewModel.ValidateFilmProfileCommand}"/>
                                         <Button x:Uid="ScanDebug_WorkbenchAdvancedButton"
                                                 AutomationProperties.AutomationId="WorkbenchAdvancedButton"
                                                 HorizontalAlignment="Stretch"
                                                 Click="OpenAdvancedButton_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                         <Button x:Name="WorkbenchReviewButton"
                                x:Uid="ScanDebug_WorkbenchReviewButton"
                                AutomationProperties.AutomationId="WorkbenchReviewButton"
                                TabIndex="50"
                                Click="WorkbenchReviewButton_Click"/>
                    </controls:WrapPanel>
                </Grid>

                <InfoBar
                    x:Name="FilmProfileOperationInfoBar"
                    x:Uid="ScanDebug_FilmProfileWorkbenchOperationInfoBar"
                    Grid.Row="1"
                    Margin="{StaticResource XSmallTopMargin}"
                    AutomationProperties.AutomationId="FilmProfileOperationInfoBar"
                    IsOpen="{x:Bind ViewModel.FilmProfileOperationIsOpen, Mode=TwoWay}"
                    Severity="{x:Bind ViewModel.FilmProfileOperationSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.FilmProfileOperationVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FilmProfileOperationMessage, Mode=OneWay}"
                               TextWrapping="WrapWholeWords"/>
                </InfoBar>

                <ScrollViewer x:Name="FilmProfileLifecycleDetailsScrollViewer"
                              Grid.Row="2"
                              Margin="{StaticResource XSmallTopMargin}"
                              MaxHeight="{StaticResource ScanDebugReviewMaximumHeight}"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="{StaticResource ScanDebugSectionSpacing}">
                        <ContentControl
                            x:Name="CurrentFilmProfileValidationInspector"
                            AutomationProperties.AutomationId="CurrentFilmProfileValidationInspector"
                            AutomationProperties.AccessibilityView="Control"
                            Visibility="{x:Bind ViewModel.FilmProfileWorkbenchContentVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource ScanDebugSectionCardStyle}">
                                <Grid RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               x:Uid="ScanDebug_FilmProfileWorkbenchCurrentValidationTextTitle"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextWrapping="WrapWholeWords"/>
                                     <TextBlock Grid.Row="2"
                                                x:Uid="ScanDebug_FilmProfileWorkbenchCurrentValidationDescription"
                                                Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                     <InfoBar Grid.Row="1"
                                              IsOpen="True"
                                             Message="{x:Bind ViewModel.CurrentFilmProfileValidationIssueCountText, Mode=OneWay}"
                                             Severity="{x:Bind ViewModel.CurrentFilmProfileValidationSeverity, Mode=OneWay}"/>
                                    <ScrollViewer x:Name="CurrentFilmProfileValidationIssueScrollViewer"
                                                  Grid.Row="3"
                                                  MaxHeight="224"
                                                  VerticalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Disabled">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentFilmProfileValidationIssueDisplays, Mode=OneWay}"
                                                      ItemTemplateSelector="{StaticResource FilmProfileValidationIssueTemplateSelector}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </ContentControl>

                        <Border
                            x:Name="StagedFilmProfileImportReview"
                            x:Uid="ScanDebug_StagedFilmProfileImportReview"
                            AutomationProperties.AutomationId="StagedFilmProfileImportReview"
                            AutomationProperties.AccessibilityView="Control"
                            Style="{StaticResource ScanDebugSectionCardStyle}"
                            Visibility="{x:Bind ViewModel.FilmProfileImportResultReviewVisibility, Mode=OneWay}">
                            <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportTitle"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportHelpText"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                                      RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportNameLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.StagedFilmProfileImportDisplayNameText, Mode=OneWay}"
                                               TextWrapping="WrapWholeWords"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportChannelsLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.StagedFilmProfileImportChannelCountText, Mode=OneWay}"
                                               TextWrapping="WrapWholeWords"/>
                                </Grid>
                                <InfoBar
                                    x:Uid="ScanDebug_FilmProfileWorkbenchStagedValidationInfoBar"
                                    MaxWidth="560"
                                    IsOpen="True"
                                    Message="{x:Bind ViewModel.StagedFilmProfileImportValidationIssueCountText, Mode=OneWay}"
                                    Severity="{x:Bind ViewModel.StagedFilmProfileImportSeverity, Mode=OneWay}"/>
                                <ScrollViewer x:Name="StagedFilmProfileImportValidationIssueScrollViewer"
                                              MaxHeight="160"
                                              VerticalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.StagedFilmProfileImportValidationIssueDisplays, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource FilmProfilePassiveValidationIssueTemplate}"/>
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind ViewModel.StagedFilmProfileDirtyReplacementWarningText, Mode=OneWay}"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"
                                           Visibility="{x:Bind ViewModel.StagedFilmProfileDirtyReplacementWarningVisibility, Mode=OneWay}"/>
                                <controls:WrapPanel HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                                    VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                                     <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleDiscardStagedButton"
                                             TabIndex="50"
                                             Command="{x:Bind ViewModel.DiscardStagedFilmProfileImportCommand}"/>
                                     <Button x:Uid="ScanDebug_FilmProfileWorkbenchImportChooseOtherFileButton"
                                             TabIndex="55"
                                             Command="{x:Bind ViewModel.LoadFilmProfileJsonCommand}"/>
                                     <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleApplyStagedButton"
                                            TabIndex="60"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.ApplyStagedFilmProfileImportCommand}"/>
                                </controls:WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

         <Border x:Name="WorkbenchRunBar"
                 AutomationProperties.AutomationId="WorkbenchRunBar"
                 AutomationProperties.AccessibilityView="Control"
                  Grid.Row="1"
                  Padding="0">
             <Grid x:Name="WorkbenchRunContentGrid"
                   ColumnSpacing="{StaticResource ScanDebugInlineSpacing}">
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="Auto"/>
                 </Grid.RowDefinitions>
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="Auto"/>
                 </Grid.ColumnDefinitions>
                 <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Spacing="{StaticResource ScanDebugInlineSpacing}">
                     <TextBlock x:Uid="ScanDebug_CaptureModeInlineLabel"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                     <ComboBox x:Name="CaptureModeComboBox"
                               x:Uid="ScanDebug_CaptureModeComboBox"
                              AutomationProperties.AutomationId="CaptureModeComboBox"
                              AutomationProperties.HelpText="{x:Bind ViewModel.CaptureModeScopeText, Mode=OneWay}"
                              MinWidth="{StaticResource ScanDebugCaptureMinimumWidth}"
                              MaxWidth="{StaticResource ScanDebugCaptureMaximumWidth}"
                              IsEnabled="{x:Bind ViewModel.CanEditCaptureMode, Mode=OneWay}"
                               ItemsSource="{x:Bind ViewModel.CaptureModeOptions, Mode=OneWay}"
                               ItemTemplate="{StaticResource ScanCaptureModeOptionTemplate}"
                               SelectedItem="{x:Bind ViewModel.SelectedCaptureMode, Mode=TwoWay}"/>
                 </StackPanel>
                 <controls:WrapPanel x:Name="RunActionPanel"
                                     Grid.Column="2"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Right"
                                     HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                     VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                    <Button MinWidth="104"
                            x:Uid="ScanDebug_StartButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.StartScanCommand}"/>
                    <Button MinWidth="88"
                            x:Uid="ScanDebug_StopButton"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind ViewModel.StopScanCommand}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <Button x:Uid="ScanDebug_StopAllMotorsButton"
                            AutomationProperties.AutomationId="StopAllMotorsButton"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                            Command="{x:Bind ViewModel.StopAllMotorsCommand}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            ContentTemplate="{StaticResource ScanDebugWrappingButtonContentTemplate}"/>
                 </controls:WrapPanel>
                 <controls:WrapPanel x:Name="RunStatusPanel"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                     VerticalSpacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CaptureModeUnavailableReasonText, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.CaptureModeUnavailableReasonText, Mode=OneWay}"
                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.StartDisabledReasonText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="StartDisabledReasonText"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.StartDisabledReasonText, Mode=OneWay}"
                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.StopDisabledReasonText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="StopDisabledReasonText"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.StopDisabledReasonText, Mode=OneWay}"
                                   Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                     </controls:WrapPanel>
                 <ProgressBar x:Name="RunProgressBar"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              HorizontalAlignment="Stretch"
                              Maximum="{x:Bind ViewModel.ScanReadProgressMaximum, Mode=OneWay}"
                              Value="{x:Bind ViewModel.ScanReadProgressValue, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ScanReadProgressVisibility, Mode=OneWay}"/>
             </Grid>
        </Border>

         <Grid Grid.Row="2" RowSpacing="{StaticResource ScanDebugInlineSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
         <Grid x:Name="WorkbenchWorkspaceHeader"
               Grid.Row="0"
               ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
               RowSpacing="{StaticResource ScanDebugInlineSpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
             <SelectorBar x:Name="WorkbenchTaskSelectorBar"
                          Grid.Column="0"
                          AutomationProperties.AutomationId="WorkbenchTaskSelectorBar"
                          HorizontalAlignment="Left"
                          SelectionChanged="WorkbenchTaskSelectorBar_SelectionChanged">
                 <SelectorBarItem x:Name="SamplingTaskButton" x:Uid="ScanDebug_WorkbenchSamplingTaskButton" AutomationProperties.AutomationId="WorkbenchSamplingTaskButton" IsSelected="True"/>
                 <SelectorBarItem x:Name="BlackWhiteTaskButton" x:Uid="ScanDebug_WorkbenchBlackWhiteTaskButton" AutomationProperties.AutomationId="WorkbenchBlackWhiteTaskButton"/>
                 <SelectorBarItem x:Name="FocusTaskButton" x:Uid="ScanDebug_WorkbenchFocusTaskButton" AutomationProperties.AutomationId="WorkbenchFocusTaskButton"/>
                 <SelectorBarItem x:Name="MotionTaskButton" x:Uid="ScanDebug_WorkbenchMotionTaskButton" AutomationProperties.AutomationId="WorkbenchMotionTaskButton"/>
             </SelectorBar>
              <ComboBox x:Name="WorkbenchTaskComboBox"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="WorkbenchTaskComboBox"
                        HorizontalAlignment="Left"
                        MinWidth="180"
                       SelectedIndex="0"
                       SelectionChanged="WorkbenchTaskComboBox_SelectionChanged"
                       Visibility="Collapsed">
                 <ComboBoxItem x:Uid="ScanDebug_WorkbenchSamplingTaskComboBoxItem"/>
                 <ComboBoxItem x:Uid="ScanDebug_WorkbenchBlackWhiteTaskComboBoxItem"/>
                 <ComboBoxItem x:Uid="ScanDebug_WorkbenchFocusTaskComboBoxItem"/>
                  <ComboBoxItem x:Uid="ScanDebug_WorkbenchMotionTaskComboBoxItem"/>
              </ComboBox>
              <controls:WrapPanel x:Name="WorkspacePreviewToolbar"
                                  Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                  VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                  <Button x:Name="InspectionToggleButton"
                          x:Uid="ScanDebug_WorkbenchInspectionButton"
                          AutomationProperties.AutomationId="WorkbenchInspectionButton"
                          Click="InspectionToggleButton_Click"
                          Visibility="Collapsed"/>
              </controls:WrapPanel>
             <Button x:Name="ReturnToWorkbenchTaskButton"
                      Grid.Column="2"
                     x:Uid="ScanDebug_ReturnToWorkbenchTaskButton"
                     AutomationProperties.AutomationId="ReturnToWorkbenchTaskButton"
                     Click="ReturnToWorkbenchTaskButton_Click"
                     Visibility="Collapsed"/>
             <SelectorBar
                x:Name="WorkbenchSectionSelectorBar"
                  Grid.Row="1"
                Grid.ColumnSpan="3"
                AutomationProperties.AutomationId="WorkbenchSectionSelectorBar"
                HorizontalAlignment="Stretch"
                SelectionChanged="WorkbenchSectionSelectorBar_SelectionChanged"
                Visibility="Collapsed">
