                            Click="InspectionEditRoiButton_Click"/>
                        <TextBlock x:Uid="ScanDebug_InspectionAwaitingSample"
                            Visibility="{x:Bind ViewModel.ObservationEmptyVisibility, Mode=OneWay}"
                            Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ObservationSummaryVisibility, Mode=OneWay}">
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ObservationLiveToolsVisibility, Mode=OneWay}">
                                <TextBlock x:Uid="ScanDebug_WorkbenchInspectionColumnTitle"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.ColumnSampleStatusText, Mode=OneWay}"
                                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel x:Name="InspectionEvidenceContent" Spacing="12"
                                AutomationProperties.AutomationId="InspectionDiagnosticsPanel">
                                <TextBlock x:Uid="ScanDebug_WorkbenchInspectionEvidenceTitle"
                                    Style="{StaticResource ScanDebugPanelTitleStyle}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="ScanDebug_WorkbenchInspectionDeviceEvidenceLabel"
                                        Style="{StaticResource ScanDebugGroupTitleStyle}"/>
                                    <TextBlock AutomationProperties.AutomationId="DeviceEvidenceText"
                                        Text="{x:Bind ViewModel.DeviceEvidenceText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ObservationSummaryVisibility, Mode=OneWay}">
                                    <TextBlock x:Uid="ScanDebug_WorkbenchInspectionCaptureSourceLabel"
                                        Style="{StaticResource ScanDebugGroupTitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ObservationFullSourceText, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"/>
                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ObservationRawSourceVisibility, Mode=OneWay}">
                                        <TextBlock x:Uid="ScanDebug_RawSignalSourceLabel" Style="{StaticResource ScanDebugGroupTitleStyle}"/>
                                        <TextBlock AutomationProperties.AutomationId="RawSignalSourceText"
                                            Text="{x:Bind ViewModel.ObservationRawSourceText, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
                <ScrollViewer x:Name="FilmProfileLifecycleDetailsScrollViewer"
                              Grid.Row="0" Grid.Column="5" Canvas.ZIndex="10"
                              Margin="0"
                              Width="320"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="{StaticResource ScanDebugSectionSpacing}">
                        <ContentControl
                            x:Name="CurrentFilmProfileValidationInspector"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="CurrentFilmProfileValidationInspector"
                            AutomationProperties.AccessibilityView="Control"
                            Visibility="{x:Bind ViewModel.FilmProfileWorkbenchContentVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource ScanDebugSectionCardStyle}">
                                <Grid RowSpacing="{StaticResource ScanDebugInlineSpacing}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchCurrentValidationTextTitle"
                                                   VerticalAlignment="Center"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="WrapWholeWords"/>
                                        <Button x:Name="CloseValidationReviewButton" Grid.Column="1"
                                                x:Uid="ScanDebug_CloseValidationReviewButton"
                                                Click="CloseValidationReviewButton_Click"/>
                                    </Grid>
                                     <InfoBar Grid.Row="1"
                                              IsOpen="True"
                                              IsClosable="False"
                                             Message="{x:Bind ViewModel.CurrentFilmProfileValidationIssueCountText, Mode=OneWay}"
                                             Severity="{x:Bind ViewModel.CurrentFilmProfileValidationSeverity, Mode=OneWay}"/>
                                    <StackPanel Grid.Row="3" Spacing="{StaticResource ScanDebugInlineSpacing}">
                                        <TextBlock Text="{x:Bind ViewModel.WorkbenchParameterDetailText, Mode=OneWay}"
                                                   Style="{StaticResource ScanDebugBodyStyle}"/>
                                        <Button Content="{x:Bind ViewModel.WorkbenchCalibrationStatusText, Mode=OneWay}"
                                                HorizontalAlignment="Left"
                                                ContentTemplate="{StaticResource ScanDebugWrappingButtonContentTemplate}"
                                                Click="OpenBlackWhiteTaskButton_Click"/>
                                        <TextBlock Text="{x:Bind ViewModel.WorkbenchCalibrationDetailText, Mode=OneWay}"
                                                   Style="{StaticResource ScanDebugBodyStyle}"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="CurrentFilmProfileValidationIssues"
                                                  Grid.Row="2"
                                                  ItemsSource="{x:Bind ViewModel.CurrentFilmProfileValidationIssueDisplays, Mode=OneWay}"
                                                  ItemTemplateSelector="{StaticResource FilmProfileValidationIssueTemplateSelector}"/>
                                </Grid>
                            </Border>
                        </ContentControl>

                        <Border
                            x:Name="StagedFilmProfileImportReview"
                            x:Uid="ScanDebug_StagedFilmProfileImportReview"
                            AutomationProperties.AutomationId="StagedFilmProfileImportReview"
                            AutomationProperties.AccessibilityView="Control"
                            Style="{StaticResource ScanDebugSectionCardStyle}"
                            Visibility="{x:Bind ViewModel.FilmProfileImportResultReviewVisibility, Mode=OneWay}">
                            <StackPanel Spacing="{StaticResource ScanDebugInlineSpacing}">
                                <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportTitle"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportHelpText"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
                                <Grid ColumnSpacing="{StaticResource ScanDebugInlineSpacing}"
                                      RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportNameLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.StagedFilmProfileImportDisplayNameText, Mode=OneWay}"
                                               TextWrapping="WrapWholeWords"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               x:Uid="ScanDebug_FilmProfileWorkbenchStagedImportChannelsLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.StagedFilmProfileImportChannelCountText, Mode=OneWay}"
                                               TextWrapping="WrapWholeWords"/>
                                </Grid>
                                <InfoBar
                                    x:Uid="ScanDebug_FilmProfileWorkbenchStagedValidationInfoBar"
                                    MaxWidth="560"
                                    IsOpen="True"
                                    Message="{x:Bind ViewModel.StagedFilmProfileImportValidationIssueCountText, Mode=OneWay}"
                                    Severity="{x:Bind ViewModel.StagedFilmProfileImportSeverity, Mode=OneWay}"/>
                                <ItemsControl x:Name="StagedFilmProfileImportValidationIssues"
                                              ItemsSource="{x:Bind ViewModel.StagedFilmProfileImportValidationIssueDisplays, Mode=OneWay}"
                                              ItemTemplate="{StaticResource FilmProfilePassiveValidationIssueTemplate}"/>
                                <TextBlock Text="{x:Bind ViewModel.StagedFilmProfileDirtyReplacementWarningText, Mode=OneWay}"
                                           Style="{StaticResource ScanDebugQuietTextBlockStyle}"
                                           TextWrapping="WrapWholeWords"
                                           Visibility="{x:Bind ViewModel.StagedFilmProfileDirtyReplacementWarningVisibility, Mode=OneWay}"/>
                                <controls:WrapPanel HorizontalSpacing="{StaticResource ScanDebugInlineSpacing}"
                                                    VerticalSpacing="{StaticResource ScanDebugInlineSpacing}">
                                     <Button x:Name="DiscardStagedFilmProfileImportButton"
                                             x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleDiscardStagedButton"
                                             TabIndex="50"
                                             Command="{x:Bind ViewModel.DiscardStagedFilmProfileImportCommand}"/>
                                     <Button x:Uid="ScanDebug_FilmProfileWorkbenchImportChooseOtherFileButton"
                                             TabIndex="55"
                                             Command="{x:Bind ViewModel.LoadFilmProfileJsonCommand}"/>
                                     <Button x:Uid="ScanDebug_FilmProfileWorkbenchLifecycleApplyStagedButton"
                                            TabIndex="60"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.ApplyStagedFilmProfileImportCommand}"/>
                                </controls:WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
        </Grid>

                <InfoBar
                    x:Name="FilmProfileOperationInfoBar"
                    x:Uid="ScanDebug_FilmProfileWorkbenchOperationInfoBar"
                    Grid.Row="2"
                    Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="420" Canvas.ZIndex="20"
                    MaxHeight="88"
                    AutomationProperties.AutomationId="FilmProfileOperationInfoBar"
                    IsOpen="{x:Bind ViewModel.FilmProfileOperationIsOpen, Mode=TwoWay}"
                    Severity="{x:Bind ViewModel.FilmProfileOperationSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.FilmProfileOperationVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FilmProfileOperationMessage, Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.FilmProfileOperationMessage, Mode=OneWay}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="WrapWholeWords"/>
                </InfoBar>
        </Grid>
         <Border Grid.Row="2"
                  Padding="{StaticResource ScanDebugStatusPadding}"
                  Style="{StaticResource ScanDebugSectionCardStyle}"
                  Visibility="{x:Bind ViewModel.ObservationFooterVisibility, Mode=OneWay}">
            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                <TextBlock Text="{x:Bind ViewModel.ObservationModeText, Mode=OneWay}" Style="{StaticResource ScanDebugGroupTitleStyle}"/>
                <TextBlock AutomationProperties.AutomationId="ObservationSourceSummaryText"
                    Text="{x:Bind ViewModel.ObservationSourceSummaryText, Mode=OneWay}"
                    Style="{StaticResource ScanDebugMetadataStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.ObservationFooterText, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ObservationFooterText, Mode=OneWay}"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource ScanDebugQuietTextBlockStyle}"/>
            </controls:WrapPanel>
        </Border>
    </Grid>
</Page>
